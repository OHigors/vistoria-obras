# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
expo-web*.log

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# local db backups
/backups/

# db scripts + supabase CLI local state (branches/temp/config/seed stay local)
/scripts/
/migrations/
/supabase/*
# ...but DO version the schema migrations — pure DDL (schema, policies, grants), no secrets.
!/supabase/migrations/
# Edge Functions também são código-fonte: a validação roda ali, e os segredos vêm
# do ambiente da plataforma, nunca do arquivo. Só os .env ficam de fora.
!/supabase/functions/
/supabase/functions/**/.env*

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
.vercel
